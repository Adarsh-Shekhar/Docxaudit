# ── Database (Neon) ────────────────────────────────────────────────────────────
# Neon dev/prod connection string, e.g. postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/obligation_tracker?sslmode=require

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (API-only; no local LLM is used) ──────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback provider (Gemini Flash free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Email alerts (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# ── Storage / web ─────────────────────────────────────────────────────────────
STORAGE_PATH=./uploads
FRONTEND_ORIGIN=http://localhost:5173

# ── Candidate filter tuning (accuracy lever; defaults fine) ───────────────────
FILTER_MIN_SIGNALS=1
